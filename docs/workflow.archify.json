{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Workflow: Claude Code + Codex",
    "locale": "en",
    "quality_profile": "showcase",
    "output": "docs/index.html"
  },
  "lanes": [
    {
      "id": "persona",
      "label": "You (decide and approve)"
    },
    {
      "id": "claude",
      "label": "Claude Code (understands, specifies, reviews)"
    },
    {
      "id": "atajo",
      "label": "Shortcut: small feature",
      "variant": "exception"
    },
    {
      "id": "codex",
      "label": "Codex (implements)"
    },
    {
      "id": "repo",
      "label": "Repository / git"
    }
  ],
  "phases": [
    {
      "id": "definir",
      "label": "Define",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "planificar",
      "label": "Plan + approve",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "construir",
      "label": "Build + review",
      "fromCol": 4,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "idea",
    "forge",
    "analista",
    "plan",
    "aprueba",
    "codex",
    "revision",
    "pr"
  ],
  "nodes": [
    {
      "id": "idea",
      "lane": "persona",
      "col": 0,
      "type": "external",
      "label": "Idea or request",
      "sublabel": "half-formed"
    },
    {
      "id": "aprueba",
      "lane": "persona",
      "col": 3,
      "type": "security",
      "label": "“Yes” to the plan",
      "sublabel": "permission to delegate",
      "tag": "gate"
    },
    {
      "id": "forge",
      "lane": "claude",
      "col": 0,
      "type": "backend",
      "label": "bmad-forge-idea",
      "sublabel": "optional: sharpen idea"
    },
    {
      "id": "analista",
      "lane": "claude",
      "col": 1,
      "type": "backend",
      "label": "/analista",
      "sublabel": "grilling + BMAD",
      "tag": "levels 2-4"
    },
    {
      "id": "plan",
      "lane": "claude",
      "col": 2,
      "type": "backend",
      "label": "writing-plans",
      "sublabel": "batches with criteria"
    },
    {
      "id": "revision",
      "lane": "claude",
      "col": 5,
      "type": "security",
      "label": "Review",
      "sublabel": "diff + tests",
      "tag": "verification"
    },
    {
      "id": "brainstorm",
      "lane": "atajo",
      "col": 1,
      "type": "backend",
      "label": "brainstorming",
      "sublabel": "instead of /analista"
    },
    {
      "id": "codex",
      "lane": "codex",
      "col": 4,
      "type": "messagebus",
      "label": "codex-driven-dev",
      "sublabel": "self-contained brief",
      "tag": "Codex"
    },
    {
      "id": "handoff",
      "lane": "repo",
      "col": 1,
      "type": "database",
      "label": "docs/",
      "sublabel": "handoff-specifier.md"
    },
    {
      "id": "planfile",
      "lane": "repo",
      "col": 2,
      "type": "database",
      "label": "docs/briefs/",
      "sublabel": "YYYY-MM-DD-topic.md"
    },
    {
      "id": "rama",
      "lane": "repo",
      "col": 4,
      "type": "database",
      "label": "Branch / worktree",
      "sublabel": "batch commits"
    },
    {
      "id": "pr",
      "lane": "repo",
      "col": 5,
      "type": "cloud",
      "label": "PR / MR",
      "sublabel": "record of the work",
      "tag": "never merge locally"
    }
  ],
  "edges": [
    {
      "id": "e-idea-forge",
      "from": "idea",
      "to": "forge",
      "label": "request"
    },
    {
      "id": "e-forge-analista",
      "from": "forge",
      "to": "analista",
      "label": "brief"
    },
    {
      "id": "e-analista-plan",
      "from": "analista",
      "to": "plan",
      "label": "spec",
      "variant": "emphasis"
    },
    {
      "id": "e-analista-docs",
      "from": "analista",
      "to": "handoff",
      "label": "requirements",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "e-idea-brain",
      "from": "idea",
      "to": "brainstorm",
      "label": "small feature",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "e-brain-plan",
      "from": "brainstorm",
      "to": "plan",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "e-plan-file",
      "from": "plan",
      "to": "planfile",
      "label": "saves",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "e-plan-aprueba",
      "from": "plan",
      "to": "aprueba",
      "label": "proposes",
      "variant": "emphasis"
    },
    {
      "id": "e-aprueba-codex",
      "from": "aprueba",
      "to": "codex",
      "label": "delegate batches",
      "variant": "security"
    },
    {
      "id": "e-codex-rama",
      "from": "codex",
      "to": "rama",
      "label": "implements",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "e-codex-rev",
      "from": "codex",
      "to": "revision",
      "label": "summary + diff"
    },
    {
      "id": "e-rev-codex",
      "from": "revision",
      "to": "codex",
      "label": "fix",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "e-rev-pr",
      "from": "revision",
      "to": "pr",
      "label": "tests pass",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Who does what",
      "items": [
        "Claude: understands, designs, specifies, reviews and measures",
        "Codex: large, well-scoped tasks",
        "Before delegating, Claude says so and waits for your “yes”"
      ]
    },
    {
      "dot": "amber",
      "title": "No delegation, no Superpowers",
      "items": [
        "Questions, explanations and small changes: Claude directly",
        "Non-obvious bug: systematic-debugging",
        "Documents, memory and config: outside Superpowers"
      ]
    },
    {
      "dot": "violet",
      "title": "Extras",
      "items": [
        "Review a PR yourself: bmad-walkthrough",
        "Diagrams: archify in .archify/ (not committed)",
        "Hooks: reminder router and git guards"
      ]
    }
  ]
}
